|DUT
input_vector[0] => no_xor:add_instance.b
input_vector[1] => no_xor:add_instance.a
output_vector[0] << no_xor:add_instance.output


|DUT|no_xor:add_instance
a => NAND_2:g1.A
b => NAND_2:g1.B
output <= NAND_2:g2.Y


|DUT|no_xor:add_instance|NAND_2:g1
A => Y.IN0
B => Y.IN1
Y <= Y.DB_MAX_OUTPUT_PORT_TYPE


|DUT|no_xor:add_instance|NAND_2:g2
A => Y.IN0
B => Y.IN1
Y <= Y.DB_MAX_OUTPUT_PORT_TYPE


