library ieee;
use ieee.std_logic_1164.all;
library work;
use work.Gates.all;
entity ha_v is
port(a, b: in std_logic; out1, out2: out std_logic );
end xor_v;
Architecture struct of ha_v is
Signal s1,s2,s3,s4: std_logic;
Begin 
g1: NAND_2 port map (a, b, s1 );
g2: NAND_2 port map (a, s1, s2);
g3: NAND_2 port map (b, s1, s3);
g4: NAND_2 port map (s2, s3, out1); 
g5: NAND_2 port map (a, b, s4 );
g6: NAND_2 port map (s4, s4, out2);
end struct;