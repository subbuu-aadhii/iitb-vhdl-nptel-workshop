-- A DUT entity is used to wrap your design.
--  This example shows how you can do this for the
--  Full-adder.

library ieee;
use ieee.std_logic_1164.all;

entity DUT is
   port(input_vector: in std_logic_vector(9 downto 0);
       	output_vector: out std_logic_vector(7 downto 0));
end entity;

architecture DutWrap of DUT is
	-- Instantiate your own top Module component in place of ALU_1
	
component alu is
port(s1,s0,a3,a2,a1,a0,b3,b2,b1,b0: in std_logic; y7,y6,y5,y4,y3,y2,y1,y0: out std_logic);
end component;

begin

   -- input/output vector element ordering is critical,
   -- and must match the ordering in the trace file!
   add_instance: alu port map (s1 => input_vector(9), s0 => input_vector(8), a3 => input_vector(7), a2 => input_vector(6), a1 => input_vector(5), a0 => input_vector(4), b3 => input_vector(3), b2 => input_vector(2), b1 => input_vector(1), b0 => input_vector(0),
											y7 => output_vector(7),y6 => output_vector(6),y5 => output_vector(5),y4 => output_vector(4),y3 => output_vector(3),y2 => output_vector(2),y1 => output_vector(1),y0 => output_vector(0));

end DutWrap;
