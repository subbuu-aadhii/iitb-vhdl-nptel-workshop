|DUT
input_vector[0] => mux2:add_instance.s
input_vector[1] => mux2:add_instance.inp2
input_vector[2] => mux2:add_instance.inp1
output_vector[0] <= mux2:add_instance.output


|DUT|mux2:add_instance
inp1 => AND_2:g1.A
inp2 => AND_2:g2.A
s => AND_2:g1.B
s => INVERTER:g3.A
output <= OR_2:g4.Y


|DUT|mux2:add_instance|AND_2:g1
A => Y.IN0
B => Y.IN1
Y <= Y.DB_MAX_OUTPUT_PORT_TYPE


|DUT|mux2:add_instance|AND_2:g2
A => Y.IN0
B => Y.IN1
Y <= Y.DB_MAX_OUTPUT_PORT_TYPE


|DUT|mux2:add_instance|INVERTER:g3
A => Y.DATAIN
Y <= A.DB_MAX_OUTPUT_PORT_TYPE


|DUT|mux2:add_instance|OR_2:g4
A => Y.IN0
B => Y.IN1
Y <= Y.DB_MAX_OUTPUT_PORT_TYPE


